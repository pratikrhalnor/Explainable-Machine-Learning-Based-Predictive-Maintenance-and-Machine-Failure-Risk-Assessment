
# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Jupyter Notebook
.ipynb_checkpoints/

# Model files (generated artifacts)
models/*.pkl
models/*.joblib
models/*.h5
models/*.onnx

# Dataset files
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated reports and visualizations
reports/figures/*
reports/evaluation/*
!reports/figures/.gitkeep
!reports/evaluation/.gitkeep

# Logs
*.log
logs/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# IDE settings
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Streamlit
.streamlit/secrets.toml

# Temporary files
*.tmp
*.bak
*.swp

